# ~/.config/ghostty/config.ghostty
# Ported from iTerm2 "Default" profile

# ---- Font ----
font-family = "VictorMono Nerd Font Mono"
font-style = Bold
font-size = 16
font-family = "FiraCode Nerd Font Mono"
font-feature = calt
font-feature = liga

# Note: with font-style = Bold, bold text has nowhere left to go.
# If you want the distinction back, uncomment and pick a heavier face:
# font-style-bold = "ExtraBold"

# ---- Theme ----
theme = TokyoNight
selection-background = 283457
selection-foreground = c0caf5

# ---- Window ----
window-width = 80
window-height = 25
background-opacity = 0.70
window-padding-x = 10
window-padding-y = 10

# ---- Cursor ----
cursor-style = block
cursor-style-blink = false

# ---- Behavior ----
confirm-close-surface = false
scrollback-limit = 100000000

# ---- Shell integration ----
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ---- Command-finish notifications (requires Ghostty 1.3.0+) ----
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 15s

# ---- Splits ----
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
# Verify these two against: ghostty +list-actions | grep goto_split
# They may need to be up/down rather than top/bottom.
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+shift+equal=equalize_splits

# ---- Tab navigation ----
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab

# ---- Leader-key workflow ----
# Moved off ctrl+a: as a sequence prefix it swallows beginning-of-line
# in zsh and waits indefinitely for the next key.
keybind = cmd+j>c=new_tab
keybind = cmd+j>x=close_surface
keybind = cmd+j>z=toggle_split_zoom
keybind = cmd+j>r=reload_config

# ---- Macros: send literal commands on a keypress ----
# No quotes around the parameter. Spaces are fine as-is.
# A literal = in the text will break the parser.
keybind = cmd+shift+m=text:make re && ./a.out\n
keybind = cmd+shift+r=text:norminette *.c *.h\n
keybind = cmd+shift+l=text:clear\n
keybind = cmd+shift+g=text:git status\n

# ---- Quick Terminal ----
# cmd+grave is taken by macOS ("Move focus to next window"), hence ctrl.
keybind = global:ctrl+`=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 50%
quick-terminal-screen = main
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
quick-terminal-space-behavior = move

# ---- Visual polish ----
split-divider-color = 414868
unfocused-split-fill = 1a1b26

# ---- Quality of life ----
# If quick-terminal-size ever seems to be ignored, this is the culprit:
# a cached window frame wins over the config. Set to never to rule it out.
window-save-state = always
mouse-hide-while-typing = true
copy-on-select = clipboard

# ---- Custom shader ----
# Relative paths resolve against this file's directory.
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always
